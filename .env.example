# Copy this file to .env and fill in your own values. Never commit .env (it is in .gitignore).
# Without a key, every lesson and project uses the offline mock model instead.

# Your Anthropic API key from https://console.anthropic.com/ (optional)
ANTHROPIC_API_KEY=

# Which Claude model to call. claude-haiku-5-5 is much cheaper for a whole class.
LLM_MODEL=claude-opus-5-5
